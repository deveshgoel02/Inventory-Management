# Copy this file to .env and fill in real values. Never commit .env.

APP_NAME="Shoe Xpress Inventory Intelligence"
ENVIRONMENT=development

# Local dev default (SQLite, zero setup). For production use PostgreSQL, e.g.:
# DATABASE_URL=postgresql+psycopg2://shoexpress:password@localhost:5432/shoexpress
DATABASE_URL=sqlite:///./shoexpress.db

# Generate a strong random value for production, e.g. `openssl rand -hex 32`
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_ENV_FILE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_MINUTES=10080

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

DEFAULT_CURRENCY=INR
DEFAULT_CURRENCY_SYMBOL=₹
